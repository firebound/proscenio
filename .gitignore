# Superpowers brainstorming companion (session dirs + mockups)
.superpowers/

# QA Companion local pre-restructure snapshots (not committed)
tools/qa-companion/.backup/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
# SonarScanner CLI working dir is .scannerwork/ (its default); .sonar/ is the
# user-home cache. Ignore both so a local scan leaves nothing behind.
.sonar/
.scannerwork/

# Coverage reports (generated locally before a Sonar scan; transient, not source)
.coverage
coverage.xml
htmlcov/
**/coverage/
*.lcov

# Blender
*.blend1
*.blend2
*.blend@
*.blend.bak

# Godot 4
.godot/
.import/
*.translation
export.cfg
export_presets.cfg

# Dev-only fixture copies inside the Godot dev project - canonical lives in examples/
apps/godot/test_dummy/
apps/godot/effect/
apps/godot/dummy/

# Godot's import sidecars under tests/fixtures/ - regenerated locally, not source
apps/godot/tests/fixtures/*.import

# Headless test artifacts under scripts/ - re-runnable, not source
scripts/**/*.out
scripts/**/*.log
scripts/**/*.out.proscenio
packages/validator/validate_automesh_debug/
packages/validator/validate_automesh_report.json

# Local workbench .blend forks of canonical fixtures (Save As copies
# for manual testing; never the canonical source-of-truth).
examples/**/*_workbench.blend

# Test-runner side-effect: written next to a golden when it diverges, removed
# on PASS (apps/blender/tests/run_tests.py). One repo-wide rule covers both the
# plain *.actual.proscenio and the *.expected.actual.proscenio variants, so the
# per-fixture .gitignores under examples/generated/ do not repeat it.
examples/**/*.actual.proscenio

# Atlas packer outputs (the atlas packer) - regenerated by the Pack Atlas operator
*.atlas.png
*.atlas.json

# Per-developer Claude Code workspace state
.claude/

# Secrets / local env - never commit credentials. Covers the docs app's
# .env.*.local family too (so apps/docs/.gitignore no longer repeats it).
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo

# Build artifacts
dist/
build/
out/
*.zip

# Node / UXP plugin
node_modules/
package-lock.json
yarn.lock
*-debug.log*
yarn-error.log*

# Local scratch (renders, throwaway scripts) - never committed
.scratch/
