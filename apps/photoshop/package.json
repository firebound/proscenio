{
  "name": "proscenio-photoshop-uxp",
  "version": "0.1.0",
  "description": "Proscenio Photoshop UXP plugin (PSD layers + manifest JSON exporter / importer)",
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "watch": "nodemon -w src -e ts,tsx,js,jsx,json,css,html -w webpack.config.js -x pnpm run build",
    "build": "webpack --mode development",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "codegen": "cd ../.. && uv run python -m proscenio_codegen ts",
    "uxp:load": "cd dist && uxp plugin load",
    "uxp:reload": "cd dist && uxp plugin reload",
    "uxp:watch": "cd dist && nodemon --exec \"uxp plugin reload\" -e js,css,html",
    "uxp:debug": "cd dist && uxp plugin debug"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/plugin-syntax-class-properties": "^7.12.13",
    "@babel/plugin-transform-object-rest-spread": "^7.24.0",
    "@babel/plugin-transform-react-jsx": "^7.23.4",
    "@babel/preset-typescript": "^8.0.1",
    "@types/react": "^16.14.0",
    "@types/react-dom": "^16.9.0",
    "@vitest/coverage-v8": "^4.1.10",
    "babel-loader": "^10.0.0",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.2",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "nodemon": "^3.1.7",
    "style-loader": "^4.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.3",
    "vitest": "^4.1.10",
    "webpack": "^5.108.4",
    "webpack-cli": "^7.2.1"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "react": "^16.8.6",
    "react-dom": "^16.8.6"
  },
  "pnpm": {
    "overrides": {
      "vite": "^8.1.3",
      "@babel/core": "^7.29.6"
    }
  }
}
