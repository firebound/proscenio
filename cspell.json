{
  "version": "0.2",
  "language": "en",
  "import": ["@cspell/dict-pt-br/cspell-ext.json"],
  "ignorePaths": [
    "**/pnpm-lock.yaml",
    "**/uv.lock",
    "**/package-lock.json",
    "**/*.uid",
    "PROBLEMS",
    "PROBLEMS.md",
    "specs/backlog/bugs-found.md",
    "specs/backlog/ui-feedback.md",
    "specs/021-blender-ui-audit/ia-mockup.html",
    "specs/025-code-duplication/raw/**",
    "tools/qa-companion/.backup/**",
    "tools/qa-companion/checklist/feedback.md"
  ],
  "dictionaries": [
    "ecosystem-terms",
    "proper-nouns",
    "project-terms",
    "css",
    "docker",
    "fonts",
    "html",
    "javascript",
    "json",
    "lorem",
    "pt-br",
    "tsx",
    "typescript"
  ],
  "languageId": "*",
  "caseSensitive": false,
  "dictionaryDefinitions": [
    {
      "name": "ecosystem-terms",
      "path": "./.cspell/ecosystem-terms.txt",
      "addWords": true
    },
    {
      "name": "proper-nouns",
      "path": "./.cspell/proper-nouns.txt",
      "addWords": true
    },
    {
      "name": "project-terms",
      "path": "./.cspell/project-terms.txt",
      "addWords": true
    }
  ],
  "words": ["bleh", "braba", "zizmor"],
  "ignoreWords": []
}
